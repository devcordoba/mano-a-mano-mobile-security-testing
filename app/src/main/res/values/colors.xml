<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Paleta tomada del sitio web Mano a Mano. Bordó y topo del logo. -->

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Marca -->
    <color name="primary">#7D1F2A</color>
    <color name="primary_dark">#641828</color>
    <color name="primary_mid">#9E3040</color>
    <color name="primary_light">#F5E8EA</color>

    <color name="secondary">#9B8B7A</color>
    <color name="secondary_dark">#7A6B5C</color>
    <color name="secondary_light">#EDE8E3</color>

    <color name="gold">#B8975A</color>
    <color name="gold_light">#F7F0E1</color>

    <!-- Superficies -->
    <color name="background">#FAFAF8</color>
    <color name="background_alt">#F5F3F0</color>
    <color name="surface">#FFFFFF</color>

    <!-- Texto -->
    <color name="text_primary">#1C1917</color>
    <color name="text_secondary">#78716C</color>
    <color name="text_subtle">#A8A29E</color>
    <color name="text_on_primary">#FFFFFF</color>

    <!-- Bordes -->
    <color name="card_border">#E7E5E4</color>
    <color name="border_strong">#C9C6C3</color>

    <!-- Semánticos -->
    <color name="success">#166534</color>
    <color name="success_bg">#F0FDF4</color>
    <color name="danger">#991B1B</color>
    <color name="danger_bg">#FFF5F5</color>
    <color name="warning">#92400E</color>
    <color name="warning_bg">#FFFBEB</color>
    <color name="info">#1E40AF</color>
    <color name="info_bg">#EFF6FF</color>


    <!-- Colores por componente. Apuntan a la paleta de arriba. -->

    <!-- Navbar -->
    <color name="navbar_background">@color/surface</color>
    <color name="navbar_text">@color/text_primary</color>
    <color name="navbar_icon_activo">@color/primary</color>
    <color name="navbar_icon_inactivo">@color/text_secondary</color>
    <color name="navbar_border">@color/card_border</color>

    <!-- Footer -->
    <color name="footer_background">@color/surface</color>
    <color name="footer_text">@color/text_secondary</color>
    <color name="footer_border">@color/card_border</color>

    <!-- Botón primario -->
    <color name="boton_primario_fondo">@color/primary</color>
    <color name="boton_primario_fondo_presionado">@color/primary_dark</color>
    <color name="boton_primario_texto">@color/text_on_primary</color>

    <!-- Botón alternativo -->
    <color name="boton_alterno_fondo">@android:color/transparent</color>
    <color name="boton_alterno_fondo_presionado">@color/secondary_light</color>
    <color name="boton_alterno_borde">@color/border_strong</color>
    <color name="boton_alterno_borde_presionado">@color/secondary</color>
    <color name="boton_alterno_texto">@color/text_primary</color>

    <!-- Inputs y spinners -->
    <color name="input_fondo">@color/surface</color>
    <color name="input_borde">@color/border_strong</color>
    <color name="input_borde_foco">@color/primary</color>
    <color name="input_texto">@color/text_primary</color>
    <color name="input_hint">@color/text_subtle</color>

    <!-- Tarjetas -->
    <color name="card_fondo">@color/surface</color>
    <color name="card_borde">@color/card_border</color>

    <!-- Tags -->
    <color name="tag_fondo">@color/gold_light</color>
    <color name="tag_texto">@color/secondary_dark</color>
    <color name="tag_borde">@color/border_strong</color>

    <!-- Filtros -->
    <color name="filtro_fondo">@color/surface</color>
    <color name="filtro_fondo_activo">@color/primary_light</color>
    <color name="filtro_texto">@color/text_secondary</color>
    <color name="filtro_texto_activo">@color/primary</color>

    <!-- Degradés: los extremos, el drawable se arma con <gradient> -->
    <color name="degrade_principal_inicio">@color/primary</color>
    <color name="degrade_principal_fin">@color/primary_mid</color>

    <color name="degrade_secundario_inicio">@color/secondary_dark</color>
    <color name="degrade_secundario_fin">@color/secondary</color>

    <color name="degrade_exito_inicio">#166534</color>
    <color name="degrade_exito_fin">#4ADE80</color>

</resources>