<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    tools:context=".LoginActivity">

    <!-- Logo -->
    <ImageView
        android:id="@+id/imageLogoLogin"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/logo_descripcion"
        android:layout_marginBottom="28dp"
        android:src="@drawable/logo" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvTituloLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/login_titulo"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/tvSubtituloLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:text="@string/login_subtitulo"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Campo: usuario -->
    <EditText
        android:id="@+id/etUsuarioLogin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="14dp"
        android:autofillHints="username"
        android:background="@drawable/input_background"
        android:gravity="center_vertical"
        android:hint="@string/login_hint_usuario"
        android:inputType="textPersonName"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <!-- Campo: contraseña -->
    <EditText
        android:id="@+id/etPasswordLogin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="24dp"
        android:autofillHints="password"
        android:background="@drawable/input_background"
        android:gravity="center_vertical"
        android:hint="@string/login_hint_password"
        android:inputType="textPassword"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <!-- Botón ingresar -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnIngresarLogin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/boton_primario_selector"
        android:letterSpacing="0.05"
        android:text="@string/login_boton"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Enlace a registro -->
    <TextView
        android:id="@+id/tvIrRegistroLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:textStyle="bold"
        android:padding="8dp"
        android:text="@string/login_sin_cuenta"
        android:textColor="@color/primary"
        android:textSize="14sp" />

</LinearLayout>