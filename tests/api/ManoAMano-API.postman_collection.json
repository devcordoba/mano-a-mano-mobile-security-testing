  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST login voluntario OK",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function(){ pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test('Tiene token', function(){ pm.expect(j.token).to.be.a('string'); });",
                  "pm.collectionVariables.set('token', j.token);",
                  "pm.environment.set('token', j.token);",
                  "if (j.user && j.user.id) { pm.environment.set('userId', String(j.user.id)); }",
                  "pm.test('SLA < 5000ms', function(){ pm.expect(pm.response.responseTime).to.be.below(5000); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST login org OK",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"{{orgUsername}}\", \"password\": \"{{orgPassword}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function(){ pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test('Tiene token org', function(){ pm.expect(j.token).to.be.a('string'); });",
                  "pm.environment.set('orgToken', j.token);",
                  "if (j.user && j.user.id) { pm.environment.set('orgUserId', String(j.user.id)); }"
                ]
              }
            }
          ]
        },
